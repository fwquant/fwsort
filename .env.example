# ============================================================================
# ⚠️⚠️⚠️  重要：首次使用必读
# ----------------------------------------------------------------------------
# 1. 本文件是配置模板，复制为 .env 后填入敏感值
# 2. 非敏感配置（端口、路径、开关等）统一在 fwsort/config.py 中管理
# 3. 安全提示：请勿把填好密钥的 .env 提交到 Git！.gitignore 已包含 .env
# ============================================================================

# ========== Polymarket F3 Relayer Gasless 密钥 ⚠️ ==========
# 获取方法：
#   POLYMARKET_RELAYER_API_KEY_ADDRESS — 钱包地址（MetaMask/OKX Wallet 顶部 0x...）
#   POLYMARKET_RELAYER_API_KEY — Polymarket API Key（Profile → API Keys → Create）
#   POLYMARKET_RELAYER_PRIVATE_KEY — 钱包私钥（MetaMask → 账户详情 → 导出私钥）
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_PRIVATE_KEY=

# ========== 其他敏感密钥（可选） ==========
# AI 智能体 API Key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OKX 网关密钥
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# 旧版 Polymarket 钱包密钥（非 F3 Relayer 模式时使用）
POLYMARKET_APIKEY=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=