# ============================================================================
# ⚠️⚠️⚠️  重要：交易密钥请在此处填入（首次使用必读）  ⚠️⚠️⚠️
# ----------------------------------------------------------------------------
# Polymarket 网关（不填则无法连接 / 查余额 / 下单，仅能查公开行情）：
#   • POLYMARKET_WALLET_PRIVATE_KEY  ← 钱包私钥（必填，含 0x 前缀）
#   • POLYMARKET_WALLET_ADDRESS      ← 钱包地址（必填，含 0x 前缀）
#   • POLYMARKET_API_KEY             ← L2 API Key（可选，未填则自动派生）
# OKX 网关（不填则降级模拟盘）：
#   • OKX_API_KEY / OKX_SECRET / OKX_PASSPHRASE
# AI 智能体（不填则降级 MOCK）：
#   • OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY
# ----------------------------------------------------------------------------
# ⚠️  安全提示：请勿把填好密钥的 .env 提交到 Git！.gitignore 已包含 .env
# ============================================================================

# ========== 应用基础配置 ==========
APP_NAME=fwsort
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production-please-use-32-bytes-random
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TTL_MIN=30
APP_JWT_REFRESH_TTL_DAYS=7

# ========== 数据库 ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fwsort
POSTGRES_PASSWORD=fwsort_pwd
POSTGRES_DB=fwsort
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== Elasticsearch（订单执行日志检索） ==========
ES_HOST=http://localhost:9200
ES_INDEX_ORDER_LOG=order_execution_log

# ========== AI 智能体 API（多智能体策略-订单执行规则V1.0） ==========
# 3 智能体：GPT-4o / Claude 3.5+ / Gemini 2.0+
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hermes MoA（NousResearch Mixture-of-Agents）
HERMES_MOA_ENABLED=true
HERMES_MOA_LAYERS=2  # 聚合层数

# ========== 交易平台（模拟盘模式） ==========
TRADE_MODE=simulator  # simulator / live

# ---- Polymarket 网关密钥（⚠️ 不填则无法连接/查余额/下单）----
POLYMARKET_API_KEY=
POLYMARKET_WALLET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_CHAIN=polygon
# 网关主机：MAINNET(主网) / GOERLI(测试) / MOCK(模拟)
POLYMARKET_HOST=MAINNET
POLYMARKET_HTTP_TIMEOUT=10.0
POLYMARKET_ORDER_RETRY=2

# ---- OKX 网关密钥（不填则降级模拟盘）----
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_FLAG=0  # 0=实盘 1=模拟盘

# ============================================================================
# Polymarket BTC 5min 模块（每 5 分钟到期的 BTC 涨跌预测市场）
# 集中配置区段：所有 BTC 5min 相关参数在此统一管理
# ============================================================================
# 是否启用 BTC 5min 自动轮询（默认关闭，需先填好 Polymarket 密钥）
POLYMARKET_BTC5M_ENABLED=false
# 市场 slug 前缀（用于在 /markets 接口过滤活跃 BTC 5min 市场）
POLYMARKET_BTC5M_SLUG_PREFIX=bitcoin-up-or-down
# 轮询/自动下单节奏（秒），300=5分钟
POLYMARKET_BTC5M_POLL_SECONDS=300
# 默认下单方向：UP / DOWN
POLYMARKET_BTC5M_DEFAULT_SIDE=UP
# 默认下单金额（USD）
POLYMARKET_BTC5M_DEFAULT_AMOUNT_USD=5.0
# 是否启用自动下单（false=仅轮询查询不下单）
POLYMARKET_BTC5M_AUTO_ORDER=false
# 价格边界（避免极端价格成交）
POLYMARKET_BTC5M_PRICE_FLOOR=0.05
POLYMARKET_BTC5M_PRICE_CAP=0.95
# 单笔最大金额（USD）风控上限
POLYMARKET_BTC5M_MAX_AMOUNT_USD=50.0
# 同时最大持仓订单数
POLYMARKET_BTC5M_MAX_OPEN_ORDERS=5
# 订单过期秒数（默认 24h）
POLYMARKET_BTC5M_ORDER_TTL_SECONDS=86400

# ========== 下单与风控（V1.0规则） ==========
ORDER_BASE_USD=5.0          # 基础单笔金额
ORDER_DOUBLE_USD=10.0       # 全同加倍金额
PREDICTION_TIMEFRAME=15m    # 15m / 1h
RISK_SINGLE_RATIO=0.20      # 单笔不超过账户余额 20%
RISK_DAILY_LOSS_RATIO=0.30  # 单日累计亏损达 30% 强停

# ========== 榜单权重（福纹综合分） ==========
WEIGHT_ANNUALIZED=0.30
WEIGHT_DRAWDOWN=0.20
WEIGHT_SHARPE=0.20
WEIGHT_PROFIT_LOSS=0.15
WEIGHT_EXECUTION=0.15

# ========== 数据保留 ==========
ORDER_LOG_HOT_DAYS=90
RANK_SNAPSHOT_KEEP_DAYS=3650
