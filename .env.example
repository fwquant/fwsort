# ========== 应用基础配置 ==========
APP_NAME=fwsort
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production-please-use-32-bytes-random
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TTL_MIN=30
APP_JWT_REFRESH_TTL_DAYS=7

# ========== 数据库 ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fwsort
POSTGRES_PASSWORD=fwsort_pwd
POSTGRES_DB=fwsort
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== Elasticsearch（订单执行日志检索） ==========
ES_HOST=http://localhost:9200
ES_INDEX_ORDER_LOG=order_execution_log

# ========== AI 智能体 API（多智能体策略-订单执行规则V1.0） ==========
# 3 智能体：GPT-4o / Claude 3.5+ / Gemini 2.0+
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hermes MoA（NousResearch Mixture-of-Agents）
HERMES_MOA_ENABLED=true
HERMES_MOA_LAYERS=2  # 聚合层数

# ========== 交易平台（模拟盘模式） ==========
TRADE_MODE=simulator  # simulator / live
POLYMARKET_API_KEY=
POLYMARKET_WALLET_PRIVATE_KEY=
POLYMARKET_CHAIN=polygon
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_FLAG=0  # 0=实盘 1=模拟盘

# ========== 下单与风控（V1.0规则） ==========
ORDER_BASE_USD=5.0          # 基础单笔金额
ORDER_DOUBLE_USD=10.0       # 全同加倍金额
PREDICTION_TIMEFRAME=15m    # 15m / 1h
RISK_SINGLE_RATIO=0.20      # 单笔不超过账户余额 20%
RISK_DAILY_LOSS_RATIO=0.30  # 单日累计亏损达 30% 强停

# ========== 榜单权重（福纹综合分） ==========
WEIGHT_ANNUALIZED=0.30
WEIGHT_DRAWDOWN=0.20
WEIGHT_SHARPE=0.20
WEIGHT_PROFIT_LOSS=0.15
WEIGHT_EXECUTION=0.15

# ========== 数据保留 ==========
ORDER_LOG_HOT_DAYS=90
RANK_SNAPSHOT_KEEP_DAYS=3650
