# ============================================================================
# ⚠️⚠️⚠️  敏感配置模板 — 复制为 .env 后填入真实值
# ----------------------------------------------------------------------------
# 1. 本文件是配置模板，复制为 .env 后填入敏感值
# 2. 非敏感配置（端口、路径、开关等）统一在 config/*.yaml 中管理
# 3. 安全提示：请勿把填好密钥的 .env 提交到 Git！.gitignore 已包含 .env
# ============================================================================


# ========== 数据库密码 ==========
POSTGRES_PASSWORD=
REDIS_PASSWORD=


# ========== AI 智能体 API Key ==========
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ========== Polymarket 交易密钥 ==========

# L1 交易方法（钱包地址+私钥，手动操作）
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=

# L2 交易方法（API Key + Secret + Passphrase，程序化）
POLYMARKET_APIKEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# L3 交易方法（Relayer 免 Gas）
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_RELAYER_PRIVATE_KEY=
POLYMARKET_RELAYER_API_KEY=


# ========== OKX 交易密钥 ==========
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=