# ============================================================================
# ⚠️⚠️⚠️  重要：交易密钥请在此处填入（首次使用必读）  ⚠️⚠️⚠️
# ----------------------------------------------------------------------------
# Polymarket 网关（不填则无法下单/查余额，仅能查公开行情）：
#   • POLYMARKET_WALLET_PRIVATE_KEY  ← 钱包私钥（必填，含 0x 前缀）
#   • POLYMARKET_WALLET_ADDRESS      ← 钱包地址（必填，含 0x 前缀）
#   • POLYMARKET_API_KEY             ← L2 API Key（可选，未填则自动派生）
#
#   🔑 密钥获取方法（详见下方"Polymarket 密钥获取指南"区段）：
#     1. 钱包私钥 & 地址：从 MetaMask 导出，或用 eth_account 生成
#     2. 钱包里需要有 USDC.e（Polygon 链）作为保证金
#     3. L2 API Key：首次下单时由网关自动派生（/auth/derive-api-key），
#        也可从 Polymarket 网站 Profile > API Keys 手动创建
#
# OKX 网关（不填则降级模拟盘）：
#   • OKX_API_KEY / OKX_SECRET / OKX_PASSPHRASE
# AI 智能体（不填则降级 MOCK）：
#   • OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY
# ----------------------------------------------------------------------------
# ⚠️  安全提示：请勿把填好密钥的 .env 提交到 Git！.gitignore 已包含 .env
# ============================================================================

# ========== 应用基础配置 ==========
APP_NAME=fwsort
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production-please-use-32-bytes-random
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TTL_MIN=30
APP_JWT_REFRESH_TTL_DAYS=7

# ========== 数据库 ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fwsort
POSTGRES_PASSWORD=fwsort_pwd
POSTGRES_DB=fwsort
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== Elasticsearch（订单执行日志检索） ==========
ES_HOST=http://localhost:9200
ES_INDEX_ORDER_LOG=order_execution_log

# ========== AI 智能体 API（多智能体策略-订单执行规则V1.0） ==========
# 3 智能体：GPT-4o / Claude 3.5+ / Gemini 2.0+
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hermes MoA（NousResearch Mixture-of-Agents）
HERMES_MOA_ENABLED=true
HERMES_MOA_LAYERS=2  # 聚合层数

# ========== 交易平台（模拟盘模式） ==========
TRADE_MODE=simulator  # simulator / live

# ---- Polymarket 网关密钥（⚠️ 不填则无法下单/查余额）----
# ============================================================================
# 🔑 Polymarket 密钥获取指南
# ============================================================================
#
#  Polymarket 下单需要 3 项配置（2 必填 + 1 可选）：
#
#  ┌─────────────────────────────────────────────────────────────────────┐
#  │ 1. POLYMARKET_WALLET_PRIVATE_KEY（必填）                          │
#  │    用途：EIP-712 签名订单 + L1 认证                               │
#  │    获取方式：                                                       │
#  │    a) MetaMask → 账户详情 → 导出私钥（64 位 hex，含 0x 前缀）     │
#  │    b) Python 生成：                                                 │
#  │       from eth_account import Account                               │
#  │       acct = Account.create()                                      │
#  │       print(acct.key.hex(), acct.address)                          │
#  │    ⚠️  私钥 = 资金控制权，绝不分享/提交 Git                        │
#  ├─────────────────────────────────────────────────────────────────────┤
#  │ 2. POLYMARKET_WALLET_ADDRESS（必填）                              │
#  │    用途：订单 maker/signer 标识 + 查余额/持仓                      │
#  │    获取方式：                                                       │
#  │    a) MetaMask 顶部显示的 0x... 地址                               │
#  │    b) 如果填了 PRIVATE_KEY 但未填 ADDRESS，网关会自动推导          │
#  ├─────────────────────────────────────────────────────────────────────┤
#  │ 3. POLYMARKET_API_KEY（可选）                                     │
#  │    用途：L2 HMAC 签名（CLOB 私有端点鉴权）                        │
#  │    获取方式：                                                       │
#  │    a) 🔥 推荐：留空，网关首次下单时自动派生（/auth/derive-api-key）│
#  │    b) 手动：登录 https://polymarket.com → Profile → API Keys      │
#  │       → Create API Key → 复制 apiKey/secret/passphrase            │
#  │    注：手动创建的 key 需同时填写 api_secret 和 api_passphrase     │
#  │        （目前 .env 暂未暴露这两个字段，推荐用自动派生）            │
#  ├─────────────────────────────────────────────────────────────────────┤
#  │ 💰 资金准备                                                        │
#  │    • 钱包需要在 Polygon 链上有 USDC.e 余额作为保证金              │
#  │    • 充值：从交易所提 USDC.e 到该钱包地址（选 Polygon 网络）      │
#  │    • 最低约 $1 即可测试下单                                        │
#  ├─────────────────────────────────────────────────────────────────────┤
#  │ 🔗 连接流程（代码自动完成，无需手动）                              │
#  │    1. 加载 private_key → 生成 Account 对象（eth_account）         │
#  │    2. L1 签名（EIP-712 ClobAuth）→ 请求 /auth/derive-api-key     │
#  │    3. 拿到 L2 凭据（apiKey + secret + passphrase）                │
#  │    4. 后续下单请求用 L2 HMAC 签名（POLY_API_KEY / POLY_SIGNATURE）│
#  │    5. 订单签名用 EIP-712 Exchange 域（version=2）                 │
#  └─────────────────────────────────────────────────────────────────────┘
#
# ============================================================================
POLYMARKET_APIKEY=
POLYMARKET_PRIVATE_KEY=      #必填
POLYMARKET_WALLET_ADDRESS=          #必填
POLYMARKET_CHAIN=polygon

# Polymarket RELAYER 连接网关
#   ├─────────────────────────────────────────────────────────────────────┤
#   │   POLYMARKET_RELAYER_API_KEY_ADDRESS 注：为钱包 地址，获取方法：MetaMask|okx/Polygon Wallet 顶部显示的 0x... 地址
#   │   POLYMARKET_RELAYER_API_KEY 注：为POLymarket API Key，获取方法：登录 https://polymarket.com → Profile → API Keys → Create API Key → 复制 apiKey/secret/passphrase
#   │   POLYMARKET_RELAYER_PRIVATE_KEY 注：为钱包私钥，获取方法(CHROME)：MetaMask → 账户详情 → 导出私钥（64 位 hex，含 0x 前缀）,okx钱包首页 → 点击对应链资产 → 右上角「・・・更多」→ 账户信息 → 查看私钥
#   └─────────────────────────────────────────────────────────────────────┘
POLYMARKET_RELAYER_API_KEY_ADDRESS=0xfcbd
POLYMARKET_RELAYER_API_KEY=019f
POLYMARKET_RELAYER_PRIVATE_KEY=0x08cd


# 网关主机：MAINNET(主网) / GOERLI(测试) / MOCK(模拟)
POLYMARKET_HOST=MAINNET
POLYMARKET_HTTP_TIMEOUT=10.0
POLYMARKET_ORDER_RETRY=2

# ---- OKX 网关密钥（不填则降级模拟盘）----
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_FLAG=0  # 0=实盘 1=模拟盘

# ============================================================================
# Polymarket BTC 5min 模块（每 5 分钟到期的 BTC 涨跌预测市场）
# 集中配置区段：所有 BTC 5min 相关参数在此统一管理
# ============================================================================
# 是否启用 BTC 5min 自动轮询（默认关闭，需先填好 Polymarket 密钥）
POLYMARKET_BTC5M_ENABLED=false
# 市场 tag 前缀（用于在 Gamma /markets 接口通过 tag 参数过滤活跃 BTC 5min 市场）
POLYMARKET_BTC5M_SLUG_PREFIX=btc-updown-5m
# 轮询/自动下单节奏（秒），300=5分钟
POLYMARKET_BTC5M_POLL_SECONDS=300
# 默认下单方向：UP / DOWN
POLYMARKET_BTC5M_DEFAULT_SIDE=UP
# 默认下单金额（USD）
POLYMARKET_BTC5M_DEFAULT_AMOUNT_USD=5.0
# 是否启用自动下单（false=仅轮询查询不下单）
POLYMARKET_BTC5M_AUTO_ORDER=false
# 价格边界（避免极端价格成交）
POLYMARKET_BTC5M_PRICE_FLOOR=0.05
POLYMARKET_BTC5M_PRICE_CAP=0.95
# 单笔最大金额（USD）风控上限
POLYMARKET_BTC5M_MAX_AMOUNT_USD=50.0
# 同时最大持仓订单数
POLYMARKET_BTC5M_MAX_OPEN_ORDERS=5
# 订单过期秒数（默认 24h）
POLYMARKET_BTC5M_ORDER_TTL_SECONDS=86400

# ========== 下单与风控（V1.0规则） ==========
ORDER_BASE_USD=5.0          # 基础单笔金额
ORDER_DOUBLE_USD=10.0       # 全同加倍金额
PREDICTION_TIMEFRAME=15m    # 15m / 1h
RISK_SINGLE_RATIO=0.20      # 单笔不超过账户余额 20%
RISK_DAILY_LOSS_RATIO=0.30  # 单日累计亏损达 30% 强停

# ========== 榜单权重（福纹综合分） ==========
WEIGHT_ANNUALIZED=0.30
WEIGHT_DRAWDOWN=0.20
WEIGHT_SHARPE=0.20
WEIGHT_PROFIT_LOSS=0.15
WEIGHT_EXECUTION=0.15

# ========== 数据保留 ==========
ORDER_LOG_HOT_DAYS=90
RANK_SNAPSHOT_KEEP_DAYS=3650